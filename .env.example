# DealFinder AI — Environment Configuration Template
# Duplicate this file as .env.local for local development.
# IMPORTANT: Never commit .env or .env.local to Git!

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="DealFinder AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY SECRETS
# -----------------------------------------------------------------------------
# 256-bit cryptographically random secret string used for session signing
SESSION_SECRET="generate_a_64_character_hex_random_secret_for_production"

# Session expiration in milliseconds (default: 30 days = 2592000000)
SESSION_MAX_AGE_MS="2592000000"

# -----------------------------------------------------------------------------
# TRANSACTIONAL EMAIL PROVIDER (PASSWORD RESET & PRICE ALERTS)
# -----------------------------------------------------------------------------
# Optional: Resend API Key for live password recovery link emails
RESEND_API_KEY=""
EMAIL_FROM="DealFinder AI <security@dealfinder.ai>"

# Optional SMTP fallback credentials
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PRODUCTION)
# -----------------------------------------------------------------------------
# In local development, the application stores isolated data in git-ignored data/dealfinder_db.json.
# For production scale (PostgreSQL / Supabase / Neon / PlanetScale), provide:
DATABASE_URL=""
DATABASE_DIRECT_URL=""

# -----------------------------------------------------------------------------
# RETAILER DATA FEED APIS (OPTIONAL)
# -----------------------------------------------------------------------------
# Real-time partner affiliate or price comparison feed keys
AMAZON_PAAPI_KEY=""
AMAZON_PAAPI_SECRET=""
FLIPKART_AFFILIATE_ID=""
FLIPKART_AFFILIATE_TOKEN=""
